# Required: transcription + scope extraction (via OpenRouter → NVIDIA)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required for live SA supplier price lookup
# https://serper.dev
SERPER_API_KEY=

# Session signing (min 32 chars in production)
AUTH_SECRET=change-me-to-a-long-random-string-in-production

# Production database (Neon Postgres) — omit for local file storage in .data/
# DATABASE_URL=postgresql://...

# Public app URL for share links (production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email quotes to clients (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SiteQuote <quotes@yourdomain.com>

# Optional: persist voice/video uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Mobile: point Expo to your API
# EXPO_PUBLIC_API_URL=http://localhost:3000
